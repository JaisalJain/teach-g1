# Cloned upstream repos (HERO, WiLoR, ...). Exact commits are recorded in docs/log.md.
third_party/*
!third_party/.gitkeep

# Raw Stray Scanner recordings: exactly the four clips of this project are committed (see data/raw/README.md); anything else
# in data/raw/ (for example the app's zip exports) stays ignored.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/26d4118b0c/
!data/raw/4e103843db/
!data/raw/49aff04f7a/
!data/raw/e8825dea53/
*.r3d

# Model weights / checkpoints
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.h5
checkpoints/
weights/

# Large videos (GIFs for the README are fine; force-add a small mp4 with `git add -f` if needed)
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv
*.webm
# ...except the four raw clips' own videos (committed on purpose, see data/raw/README.md)
!data/raw/26d4118b0c/rgb.mp4
!data/raw/4e103843db/rgb.mp4
!data/raw/49aff04f7a/rgb.mp4
!data/raw/e8825dea53/rgb.mp4

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Tooling / run outputs
MUJOCO_LOG.TXT
wandb/
outputs/
.vscode/
.DS_Store

# Third-party model files (MANO is licensed, never redistribute)
*.pkl

# Archives (e.g. the MANO zip: licensed, never redistribute) and cached pipeline work files
*.zip
data/work/

# Agent scratch space (never committed)
tmp/
